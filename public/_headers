# Cache navigateur (Cloudflare Pages). Les fichiers de /_next/static ont un nom unique par version :
# on peut les garder un an. Le modèle 3D et les images changent d'adresse (?v=…) quand ils changent.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000
